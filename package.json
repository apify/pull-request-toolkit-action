{
    "name": "pull-request-toolkit-action",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "author": "Apify team",
    "license": "Apache",
    "scripts": {
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "test": "vitest run .",
        "type-check": "tsc --noemit"
    },
    "devDependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "@apify/oxlint-config": "^0.3.0",
        "@apify/tsconfig": "^0.2.0",
        "@octokit/types": "^17.0.0",
        "@types/node": "^24.13.3",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "onFail": "error",
            "version": "24"
        },
        "packageManager": {
            "name": "pnpm",
            "onFail": "error",
            "version": "11.22.0"
        }
    }
}
